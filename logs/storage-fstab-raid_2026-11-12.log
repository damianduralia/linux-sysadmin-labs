#!/bin/bash
# lab01 incident break script, written by Claude
cp /etc/fstab /etc/fstab.prebreak
NEW=$(cat /proc/sys/kernel/random/uuid)
sed -i "/ \/mnt\/logs /s/UUID=[^ ]*/UUID=$NEW/" /etc/fstab
systemctl daemon-reload
umount /mnt/logs
cat > /root/lab01/ticket.txt <<'TXT'
TICKET: after last night's maintenance the app on rocky
cannot write its logs. /mnt/logs should be its own volume.
Find out why. Fix it so it survives a reboot.
Diagnose first.
TXT
cat /root/lab01/ticket.txt
