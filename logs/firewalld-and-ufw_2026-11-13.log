damian@ubuntu:~$ # rocky got err 7 on port 80 no route to host
# because the packet was rejected. pings worked so its
# not a routing issue, ubuntu is reachable and
# firewalld is rejecting the packet. ufw has port 80
# configured with allow but on ubuntu both firewalld
# and ufw are running with different configurations
# and firewalld has no port 80. any packet has to go
# through 2 firewalls so it has to comply with both
# firewalls rules. the fix is to disable, mask or
# remove firewalld from ubuntu because the standard
# ubuntu firewall is ufw
damian@ubuntu:~$ sudo systemctl disable --now firewalld
Removed "/etc/systemd/system/multi-user.target.wants/firewalld.service".
Removed "/etc/systemd/system/dbus-org.fedoraproject.FirewallD1.service".
